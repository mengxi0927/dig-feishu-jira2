# Jira / Tempo（不要把真实密码提交到代码仓库）
JIRA_BASE_URL=https://jira.scity.cn
JIRA_USERNAME=
JIRA_PASSWORD=

# 飞书自建应用
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 已验证截图 URL 中的 token 可直接作为多维表格 app_token，避免申请 Wiki 读取权限。
FEISHU_WIKI_NODE_TOKEN=
FEISHU_APP_TOKEN=C8rxwJXuYimZsKkY0RKcjPxpnCf
# Tempo 原始派工基础表（23 个字段）
FEISHU_TABLE_ID=tblaButiER9WUiIJ
# 日粒度治理表（日期、姓名、项目号、工时）
FEISHU_DAILY_TABLE_ID=tblwy3hWdQIv1JhL
# 目标“工时信息”表的实际字段名；预览中的逻辑字段仍为“工时”。
FEISHU_DAILY_HOURS_FIELD=工时（小时）
# 新策略需先 preview 核对历史基线，再 initialize；未初始化时拒绝正式写入。
ASSIGNMENT_STRATEGY=monthly-delta
# 原“工时信息-补录”现名“工时信息-补录-9月”，用于复制月表字段/公式。
FEISHU_BACKFILL_TEMPLATE_TABLE_ID=tblVEzscKMM0EGwh
# Jira 标准 Worklog API 报工明细表
FEISHU_WORKLOG_TABLE_ID=tblZjQL48vL9oOAZ
FEISHU_WORKLOG_HOURS_FIELD=工时（小时）

# 服务
HOST=127.0.0.1
PORT=8787
# 本地保持关闭；仅在唯一服务器上开启写入和每天北京时间06:00的派工调度。
ASSIGNMENT_SCHEDULE_ENABLED=false
WORKLOG_SCHEDULE_ENABLED=false
SYNC_WRITE_ENABLED=false
# 必须与服务器实际 hostname 完全一致；不是网站域名。未设置时禁止所有同步写入。
SYNC_ALLOWED_HOSTNAME=
TIMEZONE_OFFSET=+08:00
STATE_FILE=./data/sync-state.json
STRICT_FIELD_CHECK=true
# true 时，只要有源记录缺少联合主键或有效日工时，就在写入两张表前停止。
STRICT_DAILY_GOVERNANCE=true

# true 时，同步某天后会删除“本地状态中存在、但 Jira 当天已不存在”的飞书记录。
# 首次部署建议保持 false，确认结果后再开启。
SYNC_DELETE_MISSING=false

# 日粒度联合主键变化时，删除本地状态中同一天对应的旧记录。
# 删除范围仅限本服务曾创建且记录在 STATE_FILE 中的记录。
SYNC_DAILY_DELETE_MISSING=true

# 报工同步：默认严格校验并让指定日期范围严格镜像 Jira Worklog。
STRICT_WORKLOG_GOVERNANCE=true
WORKLOG_SYNC_DELETE_MISSING=true
# 可选：附加到 worklogDate 日期条件后的 JQL，例如 project = ABC。
WORKLOG_JQL_EXTRA=
WORKLOG_CONCURRENCY=6
WORKLOG_PAGE_SIZE=100
